#!/bin/bash
#!
#! Example SLURM job script for Peta4-CascadeLake (Cascade Lake CPUs, HDR IB)
#! Last updated: Fri 18 Sep 12:24:48 BST 2020
#!


#! sbatch directives begin here ###############################
#! Name of the job:
#SBATCH -J Acetal
#! Which project should be charged:
#SBATCH -p CLUSTER
#! How many whole nodes should be allocated?
#SBATCH --nodes=1
#! How many (MPI) tasks will there be in total? (<= nodes*56)
#! The Cascade Lake (cclake) nodes have 56 CPUs (cores) each and
#! 3410 MiB of memory per CPU.
#SBATCH --cpus-per-task=16
#! How much wallclock time will be required?
#SBATCH --time=12:50:00
#! What types of email messages do you wish to receive?
#SBATCH --mail-type=ALL
#! Uncomment this to prevent the job from being requeued (e.g. if
#! interrupted by node failure or system downtime):
##SBATCH --no-requeue
#! Send termination signal early
#SBATCH --signal=B:USR1@60
#! Send stdout/stderr to slurm_out/ (relative to submission directory)
#SBATCH -o slurm_out/slurm-%j.out
#SBATCH -e slurm_out/slurm-%j.err



#! Insert additional module load commands after this line if needed:


#! Activate virtual environment

# Initialise conda for this shell
# source $(conda info --base)/etc/profile.d/conda.sh

source ~/.bashrc
export PATH=$HOME/.conda/envs/venv/bin:$PATH

SCRATCH=/scratch/$USER/$SLURM_JOB_ID
mkdir -p $SCRATCH
export SCRATCH


export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1

# Ensure a submission-side slurm output directory exists (helpful if submitting from shared filesystem)
mkdir -p "$SLURM_SUBMIT_DIR"/slurm_out 2>/dev/null || true

#! Full path to application executable:
application="python"

#! Run options for the application:
options="-u test_rxns.py"

#! Work directory (i.e. where the job will run):
workdir="$SLURM_SUBMIT_DIR"  # The value of SLURM_SUBMIT_DIR sets workdir to the directory
                             # in which sbatch is run.
CMD="$application $options"


###############################################################
### You should not have to change anything below this line ####
###############################################################

cd $workdir
echo -e "Changed directory to `pwd`.\n"

JOBID=$SLURM_JOB_ID

echo -e "JobID: $JOBID\n======"
echo "Time: `date`"
echo "Running on master node: `hostname`"
echo "Current directory: `pwd`"
echo -e "Scratch directory: $SCRATCH"

echo -e "\nExecuting command:\n==================\n$CMD\n"

srun --propagate=ALL $CMD
